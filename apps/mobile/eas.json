{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "pnpm": "11.18.0"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://test.crm.nodo.co.nz"
      },
      "pnpm": "11.18.0"
    },
    "production": {
      "autoIncrement": true,
      "pnpm": "11.18.0"
    }
  },
  "submit": {
    "production": {}
  }
}
