{
  "compilerOptions": {
    "target": "ES2022",
    // DOM for the globals the web and React Native both have (URL, Intl);
    // nothing here touches a document.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["jest"]
  },
  "include": ["src"]
}
