// Nodo CRM — multi-company schema.
//
// Golden rule: every business model hangs off `companyId`. Isolation is enforced
// in the data layer (src/lib/db/tenant.ts), never by trusting each query to
// remember to filter by company.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Language, money and tax
// ---------------------------------------------------------------------------

// Prisma enums don't allow hyphens: EN_GB maps to "en-GB" in the UI.
enum Language {
  EN_GB
  ES
}

// The type doesn't determine the rate: GST is 15% in New Zealand and 10% in
// Australia, so the rate is suggested by the company and frozen on each quote.
enum TaxType {
  GST
  HST
  VAT
  IVA
  TAX
}

/**
 * How tax relates to what gets typed in and to the total the customer is
 * shown. Replaces a plain `pricesIncludeTax` boolean, which could only tell
 * "already inside the price" from "add it on top" and had no way to say
 * "quote it without tax at all" or "leave it out of the figure shown here".
 * `TAX_INCLUSIVE` and `TAX_EXCLUSIVE_INCLUSIVE_TOTAL` read identically to the
 * customer — Subtotal, tax, Total (incl. tax) — because the difference between
 * them is only how the person quoting typed the numbers, never something the
 * customer can see.
 */
enum TaxDisplayMode {
  /**
   * Prices exclude tax; it's added on top and the total the customer sees includes it.
   */
  TAX_EXCLUSIVE_INCLUSIVE_TOTAL
  /**
   * Prices exclude tax, and so does the total shown — tax is handled elsewhere, off the quote.
   */
  TAX_EXCLUSIVE
  /**
   * Prices already carry the tax inside; the breakdown pulls it back out to show it.
   */
  TAX_INCLUSIVE
  /**
   * No tax applies — a service with none, nothing to break out.
   */
  NO_TAX
}

/**
 * How a quote's price is put together.
 * `ITEMIZED` breaks out lines with quantity and unit price, for work that gets
 * measured. `SECTIONS` groups the work into blocks with a title, long description
 * and an amount of their own: what a trade needs when the scope is explained in
 * prose and the price is given per item. A single price is simply a quote with
 * one section.
 * Tax and discount are worked out the same way in both: the mode only decides
 * where the subtotal comes from.
 */
enum PricingMode {
  ITEMIZED
  SECTIONS
}

/**
 * Percentage of the gross, or a flat amount on the same basis as the prices.
 * Shared by the overall discount and by each section's own — one type, used
 * the same way everywhere a discount is typed in.
 */
enum DiscountType {
  PERCENT
  FIXED
}

/**
 * How a section behaves for the customer, when `pricingMode` is `SECTIONS`.
 * `INDEPENDENT` is today's only behaviour — always counted. `OPTIONAL` is an
 * add-on the customer ticks on or off; `MULTIPLE_CHOICE` is one radio button
 * among every section marked this way in the quote, where only the chosen
 * one counts.
 */
enum QuoteSectionKind {
  INDEPENDENT
  OPTIONAL
  MULTIPLE_CHOICE
}

/**
 * Where a review came from, so it can link back to the original.
 */
/**
 * The emails a company can word for itself.
 */
enum EmailTemplateKind {
  NEW_QUOTE
  QUOTE_ACCEPTED
  FIRST_FOLLOW_UP
  SECOND_FOLLOW_UP
  REVIEW_REQUEST
}

/**
 * Whose name the customer sees in the From line.
 * A *shape*, not a name. Quotient stores the literal "Rolando Reveco" because an
 * account there is one person; here a company is a team, and a stored name would
 * sign María's quote as Rolando. The name is resolved on every send.
 */
enum SenderNameStyle {
  COMPANY
  USER
  USER_AND_COMPANY
}

enum ReviewSource {
  GOOGLE
  NOCOWBOYS
  FACEBOOK
  OTHER
}

/**
 * Ingest API key type.
 * `PUBLIC` travels in the HTML of an open site: it isn't a secret, and what
 * protects it is the allowed-domain list plus the rate limit. `SECRET` is for
 * sites that post from their own backend.
 */
enum IngestKeyType {
  PUBLIC
  SECRET
}

/**
 * Why a call to the ingest API was accepted or rejected.
 */
enum IngestOutcome {
  ACCEPTED
  INVALID_KEY
  REVOKED_KEY
  ORIGIN_NOT_ALLOWED
  RATE_LIMITED
  PAYLOAD_TOO_LARGE
  INVALID_PAYLOAD
  DUPLICATE
  HONEYPOT
}

/**
 * What the customer did on the public page of their quote.
 */
enum QuoteEventType {
  OPENED
  ACCEPTED
  DECLINED
  MESSAGE_SENT
}

/**
 * Who wrote in a quote's thread.
 */
enum MessageAuthor {
  STAFF
  CLIENT
}

/**
 * How the customer signed when accepting.
 */
enum SignatureType {
  NONE
  TYPED
  DRAWN
}

/**
 * The notices a person can receive about their company's work.
 */
enum NotificationKind {
  LEAD_RECEIVED
  LEAD_ASSIGNED
  QUOTE_OPENED
  QUOTE_DECIDED
  CLIENT_MESSAGE
  TASK_ASSIGNED
  TASK_DUE
  QUOTE_EXPIRING
  INGEST_FAILING
}

/**
 * What the customer is asked for in order to accept. Each company chooses.
 */
enum AcceptanceMode {
  SIMPLE_STATEMENT
  STATEMENT_WITH_CHECKBOX
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Company {
  id        String  @id @default(cuid())
  // Subdomain: acme -> acme.yourdomain.com
  slug      String  @unique
  name      String
  legalName String?
  taxId     String?
  email     String?
  phone     String?
  website   String?
  address   String?

  // Visual customisation
  logoUrl      String?
  /**
   * Stamped faintly in the bottom corner of the quote the customer reads. A
   * separate image from the logo: this one is seen through the page, so it is
   * usually a mark or a seal rather than the full lock-up.
   */
  watermarkUrl String?
  primaryColor String  @default("#2563eb")
  accentColor  String  @default("#0f172a")

  // The company's default language. Each user can choose their own.
  defaultLanguage Language @default(EN_GB)

  // How money looks. The currency belongs to the company, not the quote: a
  // business invoices in one currency, and that way dashboard totals can be
  // summed. `formatLocale` decides thousands separators and date format.
  currency     String @default("NZD")
  formatLocale String @default("en-NZ") @map("locale")
  timezone     String @default("Pacific/Auckland")

  // Values suggested when creating a quote; the quote keeps its own copy.
  defaultTaxType TaxType @default(GST)
  defaultTaxRate Decimal @default(15) @db.Decimal(5, 2)

  quotePrefix       String @default("COT")
  quoteValidityDays Int    @default(30)

  /**
   * Wording shared by every email that leaves the company.
   * `quoteFooter` closes all five of them; `slogan` sits under the button in the
   * quote email. The slogan is plain text on purpose — it goes right below the
   * one thing we want clicked, and a bold or a link there only competes with it.
   */
  quoteFooter String?
  slogan      String?

  /**
   * Whose name the customer reads in the From line.
   */
  senderNameStyle SenderNameStyle @default(COMPANY)

  /**
   * How long the scheduled emails wait, in days.
   * Both follow-ups count from the **send**, not one from the other: chaining
   * them would mean turning the first off silently moved the second, and the
   * screen could no longer say when each goes out. The review request counts
   * from the acceptance.
   * Whether they go at all is `EmailTemplate.enabled`, and that starts off.
   */
  firstFollowUpDays  Int @default(3)
  secondFollowUpDays Int @default(7)
  reviewRequestDays  Int @default(3)

  /**
   * Whether sending a quote also copies the priced version to the company.
   * The customer's email carries no prices, so this copy is the record of what
   * went out. It goes to `email` below, or to whoever pressed Send when that is
   * empty, so it works before anything is configured.
   */
  sendQuoteCopy Boolean @default(true)

  /**
   * Extra addresses that get the "new lead" notice, beyond the team.
   * For a shared inbox or somebody who doesn't have an account: the people who
   * do have one choose for themselves in `NotificationPreference`.
   */
  leadNotificationEmails String[] @default([])

  /**
   * Copy that accompanies every quote the company issues. It's copied onto the
   * quote at creation, so changing it doesn't rewrite what's already been sent.
   */
  quoteIntro      String?
  quoteNotes      String?
  quoteExclusions String?
  /**
   * The short terms that print on the quote itself, which is a different thing
   * from the PDF in `CompanyDocument`: the customer reads this without opening
   * anything, and the document is the full legal text attached beside it.
   */
  quoteTerms      String?
  /**
   * What kind of work this is, in general — reusable boilerplate, same
   * treatment as the four texts above it: copied onto the quote at creation,
   * and from there into a `QuoteTemplate` built off it.
   */
  quoteScope      String?

  /**
   * How tax relates to the prices typed in and to the total the customer sees.
   * In New Zealand the Fair Trading Act requires showing the end consumer the
   * price with GST included; between businesses the opposite is customary.
   * Suggested on every new quote; the quote keeps its own copy and can change
   * it on its own while still a draft or awaiting an answer.
   */
  taxDisplayMode TaxDisplayMode @default(TAX_EXCLUSIVE_INCLUSIVE_TOTAL)

  // How the customer accepts. The statement is copied onto the quote at
  // acceptance, so changing it later doesn't rewrite what someone already accepted.
  acceptanceMode        AcceptanceMode @default(STATEMENT_WITH_CHECKBOX)
  acceptanceStatement   String?
  requireSignature      Boolean        @default(false)
  askAdditionalComments Boolean        @default(false)
  askOrderReference     Boolean        @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships             Membership[]
  loginAttempts           LoginAttempt[]
  roles                   Role[]
  invitations             Invitation[]
  leads                   Lead[]
  quotes                  Quote[]
  contacts                Contact[]
  clientCompanies         ClientCompany[]
  catalogue               CatalogueItem[]
  quoteTemplates          QuoteTemplate[]
  tasks                   Task[]
  notifications           Notification[]
  activities              Activity[]
  submissions             LeadSubmission[]
  documents               CompanyDocument[]
  ingestKeys              IngestKey[]
  ingestAttempts          IngestAttempt[]
  quoteShares             QuoteShare[]
  notificationPreferences NotificationPreference[]
  quoteEvents             QuoteEvent[]
  quoteMessages           QuoteMessage[]
  acceptances             QuoteAcceptance[]
  reviews                 CompanyReview[]
  emailTemplates          EmailTemplate[]
  reviewLinks             ReviewLink[]
  quoteTypes              CompanyQuoteType[]

  @@index([isActive])
}

/**
 * A company's own set of document kinds — "Estimate For", "Quote For",
 * "Variation For", or whatever it wants to call what it sends. Not an enum:
 * every company drew up this list differently, same reason `CatalogueItem`
 * and `ReviewLink` aren't enums either — added one at a time, each checked on
 * the way in (`@@unique([companyId, label])`).
 *
 * A quote never points back here by id. It freezes the label text itself at
 * creation, the same way it freezes `currency`/`taxType` — so deleting a type
 * later can't change what a quote already issued is shown as, and there is no
 * dangling reference to guard against.
 */
model CompanyQuoteType {
  id        String @id @default(cuid())
  companyId String

  label String
  // The order it's offered in the picker — same reason `ReviewLink.position`
  // exists.
  position Int    @default(0)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, label])
  @@index([companyId, position])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  // Null when the user only signs in through a magic link.
  passwordHash  String?
  isSuperAdmin  Boolean   @default(false)
  // These appear in the quote header: the customer sees a person, not a legal
  // entity, and needs to be able to call them.
  jobTitle      String?
  phone         String?
  // Null = inherits the language of whichever company they're working in.
  language      Language?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  tasksAssigned Task[]         @relation("TaskAssignee")
  tasksCreated  Task[]         @relation("TaskCreatedBy")
  notifications Notification[]
  sessions      Session[]
  memberships   Membership[]

  assignedLeads           Lead[]                   @relation("LeadOwner")
  ingestKeys              IngestKey[]              @relation("IngestKeyCreatedBy")
  quoteMessages           QuoteMessage[]           @relation("QuoteMessageAuthor")
  notificationPreferences NotificationPreference[]
  discardedLeads          Lead[]                   @relation("LeadDiscardedBy")
  createdQuotes           Quote[]                  @relation("QuoteCreatedBy")
  activities              Activity[]
}

// A user can belong to several companies, with a different profile in each.
model Membership {
  id        String           @id @default(cuid())
  userId    String
  companyId String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, status])
}

/**
 * One row per magic-link request, kept only to rate-limit by IP.
 *
 * The limit is deliberately global — not scoped per company the way the
 * ingest API's is — because what it protects is Resend's own account-wide
 * daily send cap, shared across every company on this instance. An attacker
 * spreading requests across several companies' subdomains would slip under
 * a per-company limit while still running the shared quota down.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  companyId String
  ipAddress String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ipAddress, createdAt])
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Profiles and permissions
// ---------------------------------------------------------------------------

// Profiles are standard (same `key` across the platform) but each company has
// its own row, so it can reassign features without affecting the others.
model Role {
  id          String   @id @default(cuid())
  companyId   String
  key         RoleKey
  // Null on standard profiles: name and description are translated from `key`.
  // They're only filled in when a company renames a profile to suit itself.
  name        String?
  description String?
  // System profiles can't be deleted; OWNER can't be edited either.
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@unique([companyId, key])
  @@index([companyId])
}

enum RoleKey {
  OWNER
  ADMIN
  MANAGER
  SALES
  VIEWER
}

// The catalogue lives in src/lib/auth/permissions.ts, which is the source of
// truth; only the key is stored here so it can be related. Name and description
// are translated from the key.
model Permission {
  id     String @id @default(cuid())
  key    String @unique
  module String

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Invitation {
  id          String           @id @default(cuid())
  companyId   String
  email       String
  roleId      String
  // Only the hash, like quote links and ingest keys: whoever holds the token can
  // join the company, and a database dump must not be enough to do that.
  hashedToken String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([companyId, email])
  @@index([companyId, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Auth.js
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Module: Leads
// ---------------------------------------------------------------------------

/**
 * The customer's own company: who a contact belongs to and where a lead comes
 * from. Neither `Company` nor `Account` was available — the first is the tenant
 * using this CRM, the second is Auth.js's OAuth link — so the name says plainly
 * which of the three companies in this schema it is.
 * Matching is on the name, which is far weaker than the email that identifies a
 * person: "Scott Builders" and "Scott Builders Ltd" land as two accounts until
 * somebody merges them. Accepted on purpose; the alternative is a list nobody
 * maintains.
 */
/**
 * A line the company quotes often: a product, a service, a coat of plaster.
 * Its only job is to stop prices being retyped. What lands on a quote is a
 * **copy** — the same rule as every other frozen field: changing the catalogue
 * later must not rewrite a quote the customer already has.
 * Retired items are kept rather than deleted, so a quote that used one still
 * makes sense next to the list it came from.
 */
/**
 * Something somebody has to do, optionally by a date.
 * Hangs off whatever it is about — a lead, a quote, a contact — and all three
 * are optional, because "ring the supplier" is a real task that belongs to
 * nothing in particular.
 */
model Task {
  id        String @id @default(cuid())
  companyId String

  title String
  notes String?
  dueAt DateTime?

  /**
   * Set once, never unset: when it was finished is part of the record.
   */
  completedAt DateTime?

  assigneeId  String?
  createdById String?

  leadId    String?
  quoteId   String?
  contactId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee  User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([companyId, assigneeId, completedAt])
  @@index([companyId, dueAt])
  @@index([leadId])
  @@index([quoteId])
}

/**
 * One notice in a person's bell.
 * Stores the **kind and its parameters**, never rendered text: the same notice
 * has to read in whatever language its recipient works in, and that can change
 * after it was created.
 * `dedupeKey` is what stops a recurring condition — a task that has been overdue
 * for a week — filling the bell with one row per check. It is unique per person,
 * so the same event can notify several people once each.
 */
model Notification {
  id        String @id @default(cuid())
  companyId String
  userId    String

  kind   NotificationKind
  /**
   * Values the message interpolates: a lead's title, a customer's name.
   */
  params Json             @default("{}")
  /**
   * Where clicking it goes, as a path inside the company's subdomain.
   */
  href   String?

  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, dedupeKey])
  @@index([userId, companyId, readAt])
  @@index([companyId, createdAt])
}

model CatalogueItem {
  id        String @id @default(cuid())
  companyId String

  name        String
  description String?
  /**
   * What one of them is: m², hour, each. Free text; every trade counts its own way.
   */
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 2)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
  @@index([companyId, name])
}

model ClientCompany {
  id        String @id @default(cuid())
  companyId String

  name    String
  taxId   String?
  email   String?
  phone   String?
  website String?
  address String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts Contact[]
  leads    Lead[]

  @@index([companyId])
  @@index([companyId, name])
}

model Contact {
  id              String   @id @default(cuid())
  companyId       String
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  position        String?
  clientCompanyId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientCompany ClientCompany? @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  leads         Lead[]
  tasks         Task[]

  @@index([companyId])
  @@index([companyId, email])
  @@index([clientCompanyId])
}

model Lead {
  id        String @id @default(cuid())
  companyId String

  // Quotient's own "Quote number", kept only on rows brought in by the
  // historical import so the script can re-run without duplicating.
  legacyQuotientNumber Int? @unique

  title          String
  description    String?
  status         LeadStatus @default(NEW)
  source         LeadSource @default(OTHER)
  // 0-100, used to prioritise within the pipeline.
  score          Int        @default(0)
  estimatedValue Decimal?   @db.Decimal(14, 2)
  currency       String     @default("NZD")

  contactId       String?
  clientCompanyId String?
  ownerId         String?

  // The prospect's details before a formal contact record exists.
  contactName  String?
  contactEmail String?
  contactPhone String?
  companyName  String?

  lostReason String?
  closedAt   DateTime?

  // Discarding doesn't delete: the lead leaves the inbox but is kept, because
  // knowing what was discarded and why is part of the commercial history.
  discardedAt   DateTime?
  discardedById String?
  discardReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  clientCompany ClientCompany?  @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  owner         User?           @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  discardedBy   User?           @relation("LeadDiscardedBy", fields: [discardedById], references: [id], onDelete: SetNull)
  submission    LeadSubmission?
  quotes        Quote[]
  activities    Activity[]
  tasks         Task[]

  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, createdAt])
  @@index([companyId, discardedAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEB
  REFERRAL
  CAMPAIGN
  COLD_CALL
  EVENT
  SOCIAL
  OTHER
}

/**
 * The submission exactly as it arrived from the company's form.
 * Immutable on purpose: the team can edit the `Lead` all they like, but what the
 * customer wrote stays untouched forever. Leads created by hand simply have no
 * submission.
 */
model LeadSubmission {
  id        String @id @default(cuid())
  companyId String
  leadId    String @unique

  // The full form, verbatim. Every company has its own and it can't be
  // predicted, so it's stored whole and shown as label/value pairs.
  payload Json

  // Standard fields extracted from the payload, so it can be filtered and searched.
  name        String?
  email       String?
  phone       String?
  companyName String?
  message     String?
  serviceType String?
  address     String?

  // Provenance, for diagnosis and to track the campaign that produced it.
  sourceUrl   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  ipAddress String?
  userAgent String?

  // Which key it came in through, so it can be traced and revoked by origin.
  ingestKeyId    String?
  /**
   * Stops a double click on the form producing two leads. Uniqueness is per
   * company: two different companies can send the same key without colliding.
   */
  idempotencyKey String?

  receivedAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ingestKey IngestKey? @relation(fields: [ingestKeyId], references: [id], onDelete: SetNull)

  @@unique([companyId, idempotencyKey])
  @@index([companyId, receivedAt])
  @@index([companyId, email])
}

/**
 * A key for the lead ingest API.
 * Only the hash is stored: the full value is shown once, at creation. The
 * `prefix` is the visible part that lets it be recognised in the list without
 * revealing the rest.
 */
model IngestKey {
  id        String        @id @default(cuid())
  companyId String
  name      String
  type      IngestKeyType @default(PUBLIC)

  /**
   * Los primeros caracteres, para identificarla: `nodo_pk_a1b2c3…`.
   */
  prefix       String
  /**
   * SHA-256 of the full token. Lookups go through this.
   */
  hashedSecret String @unique

  /**
   * Domains it's accepted from. Mandatory on public keys: it's the only thing
   * stopping someone copying the key out of the HTML and using it elsewhere.
   */
  allowedOrigins String[]

  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("IngestKeyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  submissions LeadSubmission[]
  attempts    IngestAttempt[]

  @@index([companyId, revokedAt])
}

/**
 * A record of API calls, above all the rejected ones.
 * It exists so a company can work out why its form isn't getting through without
 * having to write to anyone, and it feeds the rate limit along the way.
 */
model IngestAttempt {
  id          String  @id @default(cuid())
  /**
   * Null when the key wasn't even recognised.
   */
  companyId   String?
  ingestKeyId String?

  outcome   IngestOutcome
  origin    String?
  ipAddress String?
  /**
   * Readable detail of the rejection; never includes the token.
   */
  detail    String?

  createdAt DateTime @default(now())

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ingestKey IngestKey? @relation(fields: [ingestKeyId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([ingestKeyId, createdAt])
  @@index([ipAddress, createdAt])
}

model Activity {
  id        String       @id @default(cuid())
  companyId String
  leadId    String?
  userId    String?
  type      ActivityType
  content   String
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, leadId, createdAt])
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  /**
   * The lead's own status moved. Content is `FROM>TO`, both LeadStatus.
   */
  STATUS_CHANGE
  QUOTE_SENT
  /**
   * A quote on this lead was answered.
   * Its own type because it is not the lead's status changing: recording it as
   * `STATUS_CHANGE` put QuoteStatus values into a line that renders them as lead
   * statuses, so the log asked for `leads.status.SENT` and found nothing.
   */
  QUOTE_DECIDED
  /**
   * A sent quote was edited without reissuing it. Content is the quote's
   * number, since the customer's link stays the same and the edit is what
   * changed under it.
   */
  QUOTE_EDITED
  // Lead flow actions, each with its author and time.
  RECEIVED
  ASSIGNED
  DISCARDED
  RESTORED
  CONVERTED
}

// ---------------------------------------------------------------------------
// Module: Quotes
// ---------------------------------------------------------------------------

/**
 * A starting point for a kind of job the company quotes often.
 * Deliberately few and deliberately named: "Rockcote full replaster", not the
 * address of the last house it was used on. Somewhere to start from for a *kind*
 * of work — starting from a particular past job is what `duplicateQuote` is for,
 * and keeping the two apart is what stops this list growing into a graveyard of
 * old quotes nobody prunes.
 */
model QuoteTemplate {
  id        String @id @default(cuid())
  companyId String

  name         String
  description  String?
  /**
   * Suggested title for the quote, which the person can still change.
   */
  titlePattern String?
  pricingMode  PricingMode @default(ITEMIZED)

  intro      String?
  notes      String?
  terms      String?
  exclusions String?
  scope      String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items    QuoteTemplateItem[]
  sections QuoteTemplateSection[]

  @@index([companyId, active])
}

model QuoteTemplateItem {
  id         String @id @default(cuid())
  templateId String
  position   Int    @default(0)

  description String
  quantity    Decimal @default(1) @db.Decimal(14, 2)
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)

  template QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model QuoteTemplateSection {
  id         String @id @default(cuid())
  templateId String
  position   Int    @default(0)

  title  String
  body   String?
  amount Decimal @default(0) @db.Decimal(14, 2)
  // The section's behaviour is shape, reused across jobs, same as the rest of
  // the template — unlike its discount or who it's pre-selected for, which
  // are negotiated per job and stay off the template (see `QuoteSection`).
  kind   QuoteSectionKind @default(INDEPENDENT)

  template QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Quote {
  id          String  @id @default(cuid())
  companyId   String
  // Sequential per company; displayed as COT-000001.
  number      Int
  leadId      String?
  createdById String?

  // Quotient's own "Quote number", kept only on rows brought in by the
  // historical import so the script can re-run without duplicating.
  legacyQuotientNumber Int? @unique

  title  String
  status QuoteStatus @default(DRAFT)

  // By measured lines, or by sections with a description and an amount.
  pricingMode PricingMode @default(ITEMIZED)

  /**
   * Who it was quoted to, copied from the lead on issue.
   * Frozen on purpose: if someone edits the lead afterwards, the quote already
   * sitting in the customer's inbox can't change recipient.
   */
  clientCompanyName String?
  clientName        String?
  clientEmail       String?
  clientPhone       String?

  /**
   * The company's texts, copied on creation so they stay put.
   */
  intro      String?
  exclusions String?
  scope      String?

  /**
   * "Estimate For", "Quote For", "Variation For" — whatever the company's own
   * `CompanyQuoteType` list offered at the moment this was created. The label
   * text itself, frozen, not a reference to that row: deleting the type later
   * must not change what this quote already shows. Null only for a quote made
   * while the company had no types configured at all.
   */
  quoteType String?
  // Where the work happens — not necessarily the lead's own address, and not
  // carried into a duplicate or a template: it belongs to this one job.
  projectAddress String?

  termsDocumentId String?

  // Frozen copies of the company settings at the moment of issue: if tomorrow
  // the company changes currency, tax or language, what was already sent to the
  // customer must not change retroactively.
  currency       String         @default("NZD")
  language       Language       @default(EN_GB)
  taxType        TaxType        @default(GST)
  // Percentage applied to the subtotal (e.g. 15 for New Zealand GST).
  taxRate        Decimal        @default(15) @db.Decimal(5, 2)
  /**
   * How tax relates to what was typed in and to the total the customer was
   * shown. Suggested from the company's own setting on issue, but the quote
   * keeps its own copy and can be changed on its own — while it's still a
   * draft or awaiting an answer, same as everything else on it.
   */
  taxDisplayMode TaxDisplayMode @default(TAX_EXCLUSIVE_INCLUSIVE_TOTAL)
  // The computed discount amount, on the same basis as the prices — what
  // every existing reader already expects this field to mean, unchanged.
  discount       Decimal        @default(0) @db.Decimal(14, 2)
  /**
   * What was actually typed in to produce `discount` above: a percentage if
   * `discountType` is `PERCENT`, a flat amount if `FIXED`. Kept separately
   * because the gross it applies against can change — a customer picking
   * optional sections after the quote was sent — and recomputing then needs
   * the original intent ("10%"), not the amount that intent happened to
   * produce against the gross that existed at send time.
   */
  discountType  DiscountType   @default(FIXED)
  discountValue Decimal        @default(0) @db.Decimal(14, 2)

  /**
   * A single-threshold volume discount for sections marked `OPTIONAL`: once
   * the customer has this many selected, it applies to the sum of their net
   * amounts. All three null together means no bundle discount is configured.
   */
  optionalDiscountThreshold Int?
  optionalDiscountType      DiscountType?
  optionalDiscountValue     Decimal?      @db.Decimal(14, 2)

  // Totals calculated and persisted so a future price change can't alter a quote
  // that has already been issued.
  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  taxAmount Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)

  notes      String?
  terms      String?
  validUntil DateTime?
  sentAt     DateTime?
  decidedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy     User?             @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  termsDocument CompanyDocument?  @relation(fields: [termsDocumentId], references: [id], onDelete: SetNull)
  tasks         Task[]
  items         QuoteItem[]
  sections      QuoteSection[]
  attachments   QuoteAttachment[]
  share         QuoteShare?
  events        QuoteEvent[]
  messages      QuoteMessage[]
  acceptance    QuoteAcceptance?
  emailsSent    QuoteEmail[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, leadId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

/**
 * The company's PDF documents (terms and conditions), stored in Blob.
 * They're picked while building a quote and travel with it to the customer.
 */
model CompanyDocument {
  id        String @id @default(cuid())
  companyId String

  name        String
  url         String
  pathname    String
  contentType String @default("application/pdf")
  size        Int

  // The one proposed by default when creating a quote.
  isDefault    Boolean @default(false)
  uploadedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes  Quote[]

  @@index([companyId, isDefault])
}

/**
 * The link the customer opens their quote with, without having an account.
 * The token's hash is stored, just as with the API keys: the full value only
 * exists in the URL sent to the customer.
 */
model QuoteShare {
  id        String @id @default(cuid())
  companyId String
  quoteId   String @unique

  expiresAt DateTime?
  revokedAt DateTime?

  /**
   * The customer page's last sign of life. Updated rather than inserting a row
   * per beat: the panel only needs to know whether someone is looking right now.
   * Kept even after they leave, so "last seen" still has an answer.
   */
  lastSeenAt DateTime?
  /**
   * Whether the page said it's still here, the last time it spoke up at all.
   * `lastSeenAt` alone can't tell a closed tab from one that's merely gone
   * quiet for a few seconds — both look identical until the window in
   * `isViewingNow` runs out. This is the customer's own tab saying "I'm
   * leaving" on `pagehide`, so a closed window stops reading as watched the
   * moment it closes rather than up to a window's worth of seconds later.
   * `isViewingNow` still ANDs it with the window, as a fallback for a tab that
   * disappears without the chance to say so — a crash, a killed process.
   */
  viewing    Boolean   @default(false)
  /**
   * How many times it was opened. The sum of the OPENED events, denormalised.
   */
  openCount  Int       @default(0)

  createdAt DateTime @default(now())

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote   Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tokens  QuoteShareToken[]

  @@index([companyId])
}

/**
 * One link that opens a quote. A share can have several.
 * Only the hash is stored, so an issued token can never be read back — that is
 * what keeps a database dump from accepting a quote in a customer's name. The
 * consequence used to be that every send replaced the one hash and killed the
 * link the customer already had: a follow-up asking somebody to look at a quote
 * would break the email that first sent it to them.
 * Several hashes against one share fixes that without touching the property
 * that matters. They are still hashes; a dump is still useless. And everything
 * that decides whether a link works — revoked, expired — lives on the share, so
 * **closing the link closes all of them at once**, which is what revoking was
 * always supposed to mean.
 */
model QuoteShareToken {
  id      String     @id @default(cuid())
  shareId String
  share   QuoteShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  hashedToken String   @unique
  createdAt   DateTime @default(now())

  /**
   * Set when the company closes the link, and never cleared.
   * The share's own `revokedAt` is cleared by the next send, because sending
   * again is somebody deliberately letting the customer back in. That must not
   * resurrect the links already handed out: a company that revoked because the
   * quote went to the wrong person would be reopening the wrong person's door
   * by fixing the address and sending again.
   */
  revokedAt DateTime?

  @@index([shareId])
}

/**
 * A log of what the customer does with their quote.
 */
model QuoteEvent {
  id        String         @id @default(cuid())
  companyId String
  quoteId   String
  type      QuoteEventType

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, createdAt])
  @@index([companyId, type, createdAt])
}

/**
 * Message thread between the company and the customer, inside the quote.
 */
model QuoteMessage {
  id           String        @id @default(cuid())
  companyId    String
  quoteId      String
  author       MessageAuthor
  /**
   * Null cuando escribe el cliente, que no tiene cuenta.
   */
  authorUserId String?

  body String

  /**
   * When the other party read it.
   */
  readAt    DateTime?
  createdAt DateTime  @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  authorUser User?   @relation("QuoteMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([quoteId, createdAt])
}

/**
 * The customer's acceptance, with everything that backs it.
 * The statement text is copied here on acceptance: if the company changes it
 * afterwards, what's stored is still what that person read and accepted.
 */
model QuoteAcceptance {
  id        String @id @default(cuid())
  companyId String
  quoteId   String @unique

  acceptedByName  String
  acceptedByEmail String?

  /**
   * The legal statement exactly as it stood at the moment of acceptance.
   */
  statementText String

  signatureType SignatureType @default(NONE)
  /**
   * El texto escrito, o los trazos de la firma dibujada.
   */
  signatureData String?

  additionalComments String?
  orderReference     String?

  ipAddress String?
  userAgent String?

  acceptedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([companyId, acceptedAt])
}

/**
 * A block of work with its price.
 * The body is long text — scope, materials, conditions — and the amount sits
 * apart, so the system does the adding and no hand-typed figure is left inside
 * the prose to drift out of date.
 */
model QuoteSection {
  id       String @id @default(cuid())
  quoteId  String
  position Int

  title  String
  body   String?
  amount Decimal @db.Decimal(14, 2)

  // A negotiated term for this one job, same reason it stays off
  // `QuoteTemplateSection` — the default (0, FIXED) is a no-op, so every
  // section that exists today keeps computing exactly as before.
  discountType  DiscountType @default(FIXED)
  discountValue Decimal      @default(0) @db.Decimal(14, 2)

  // See `QuoteSectionKind`. `INDEPENDENT` reproduces today's only behaviour.
  kind QuoteSectionKind @default(INDEPENDENT)

  // Whether the company ships this pre-ticked (OPTIONAL) or pre-chosen
  // (MULTIPLE_CHOICE) — a sales decision for this customer, not something a
  // template remembers.
  selectedByDefault Boolean @default(false)

  /**
   * Null until the customer decides — falls back to `selectedByDefault`.
   * True/false once they've actually ticked or chosen something. Lives on
   * the row itself rather than a separate table: it's a 1:1 fact about this
   * section, not something that needs its own history.
   */
  customerSelected Boolean?

  quote       Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  attachments QuoteAttachment[]

  @@index([quoteId, position])
}

/**
 * Files that travel with the quote: drawings, spec sheets, markups.
 *
 * `sectionId` is optional — null for a file attached to the quote as a whole,
 * set for one attached to a single section. Both share this table rather than
 * two, because they're the same thing with a narrower scope: same upload
 * pipeline, same size/type checks, same storage path.
 */
model QuoteAttachment {
  id        String  @id @default(cuid())
  quoteId   String
  sectionId String?

  name        String
  url         String
  pathname    String
  contentType String @default("application/pdf")
  size        Int
  position    Int    @default(0)

  uploadedById String?
  createdAt    DateTime @default(now())

  quote   Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  // A section's own attachments go with it: `updateQuote` keeps a section's
  // identity across an edit precisely so this relation survives editing the
  // quote around it, and removing the section is what's meant to take its
  // files with it.
  section QuoteSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
  @@index([sectionId, position])
}

/**
 * Reviews the company adds by hand, with a link to the original.
 * They're deliberately not pulled from Google live: their terms forbid storing
 * them, so they'd have to be fetched — and paid for — every time a customer
 * opens their quote, which is exactly what the tracking panel counts.
 */
/**
 * The words a company puts on one of its customer emails.
 * A row is the company's **choices**, and only those. No row at all is the
 * ordinary state: the platform's own wording is used, and that wording is
 * translated into every interface language while anything typed here is not.
 * So the screen shows an empty field with the default as help — never as
 * content. Prefilling it would turn the default into the company's own text the
 * moment they saved, and from then on that company would sit out every
 * improvement to the default, in one language.
 * Keyed by kind rather than spread across `Company` columns so that adding a
 * sixth email is a row, not a migration.
 */
/**
 * Where the company asks its customers to leave a review.
 * Deliberately not inside this CRM. A review written here would be read by
 * nobody; the point is to send a happy customer to the places people actually
 * look. `CompanyReview` next door is the opposite direction — reviews already
 * received, typed in by hand to show on a quote.
 * A row per platform rather than a list of URLs in one field: added one at a
 * time it can be validated on the way in, and a typo in the third link of a
 * comma-separated box is invisible until somebody notices nobody reviews them.
 */
model ReviewLink {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  source   ReviewSource
  url      String
  /**
   * The order they appear in the email.
   */
  position Int          @default(0)

  createdAt DateTime @default(now())

  @@unique([companyId, source])
  @@index([companyId])
}

/**
 * One email actually sent to a customer about one quote.
 * What makes the scheduled emails safe to run daily: without it the sweep would
 * see the same quote every night and chase the same customer every night. A row
 * here means "this one has had its first follow-up", once and for good.
 * It also answers a question nobody could answer from the quote before — what
 * have we sent this customer, and when — which is why it is a log rather than a
 * boolean per kind.
 */
model QuoteEmail {
  id        String @id @default(cuid())
  companyId String
  quoteId   String
  quote     Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  kind   EmailTemplateKind
  /**
   * Where it went, frozen: the contact's address may change afterwards.
   */
  to     String
  sentAt DateTime          @default(now())

  @@unique([quoteId, kind])
  @@index([companyId])
  @@index([quoteId])
}

model EmailTemplate {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind EmailTemplateKind

  /**
   * The reference is appended by the system, so it is never typed in here.
   */
  subject  String?
  /**
   * Rich text, sanitised on save and again on render.
   */
  bodyHtml String?

  /**
   * Only meaningful for the emails that are optional. A quote send always emails
   * the customer — that is what sending is — so the screen offers no switch for
   * `NEW_QUOTE`.
   */
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, kind])
  @@index([companyId])
}

model CompanyReview {
  id        String @id @default(cuid())
  companyId String

  author      String
  rating      Int
  body        String
  source      ReviewSource @default(OTHER)
  sourceUrl   String?
  publishedAt DateTime?

  /**
   * The featured ones are those shown on quotes.
   */
  featured Boolean @default(true)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, featured, position])
}

/**
 * A person's opt-out from one kind of notice, in one company.
 * A row only exists once someone turns something off: absence means "send it".
 * That way inviting a user doesn't have to seed four rows, and adding a new kind
 * of notice doesn't leave existing people silently excluded from it.
 * Preferences are per company because the same person can be a hands-on owner in
 * one and an occasional viewer in another.
 */
model NotificationPreference {
  id        String           @id @default(cuid())
  companyId String
  userId    String
  kind      NotificationKind

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, kind])
  @@index([companyId, kind, enabled])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  position    Int
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  // Per-line discount, as a percentage.
  discount    Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @default(0) @db.Decimal(14, 2)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}
