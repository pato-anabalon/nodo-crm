{
  "expo": {
    "name": "Nodo",
    "slug": "nodo",
    "scheme": "nodo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "nz.co.nodo.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nz.co.nodo.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-localization",
      "expo-image",
      "expo-web-browser",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nodo opens your photos so you can attach them to a job.",
          "cameraPermission": "Nodo uses the camera so you can photograph the work on a job.",
          "microphonePermission": "Nodo records sound with the videos you take of a job."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nodo checks that you are on site when you clock in, and records where you clock out."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "92919c65-9152-4727-8a5d-6e03bf3b431d"
      }
    },
    "owner": "pato.anabalon"
  }
}
